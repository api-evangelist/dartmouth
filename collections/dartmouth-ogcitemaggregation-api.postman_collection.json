      },
      "item": [
        {
          "id": "128ee22e-467e-457e-a32f-a92b29c7fd7e",
          "name": "Ogc Item Aggregation Controller get Aggregations api/search/v1",
          "request": {
            "name": "Ogc Item Aggregation Controller get Aggregations api/search/v1",
            "description": {
              "content": "Returns requested aggregations from the specified site catalog collection",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "search",
                "v1",
                "collections",
                ":collectionId",
                "aggregations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "exampleAggregationName",
                  "value": "<string>",
                  "description": "<b>This is an EXAMPLE aggregation expression</b>. More aggregation expressions can be specified by adding additional query parameters, where the name of the parameter is an arbitrary alphabetic aggregation name"
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "CQL filter expression that can be used to refine the aggregation search"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Limit the number of results returned for \"bucket\"-based aggregations"
                },
                {
                  "disabled": false,
                  "key": "token",
                  "value": "<string>",
                  "description": "Token to use when accessing the underlying ArcGIS Item that represents the site."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "collectionId",
                  "description": "(Required) Key/id of the collection for which item should be filtered and returned."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "846e58be-b63f-40e0-a865-4cfb8c881787",
              "name": "A response describing requested collection aggregations",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "search",
                    "v1",
                    "collections",
                    ":collectionId",
                    "aggregations"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "exampleAggregationName",
                      "value": "terms(fields=(access,tags,source))"
                    },
                    {
                      "key": "filter",
                      "value": "type='Feature Service'"
                    },
                    {
                      "key": "limit",
                      "value": "<integer>"
                    },
                    {
                      "key": "token",
                      "value": "<string>"
                    }
                  ],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "collectionId",
                      "description": "(Required) Key/id of the collection for which item should be filtered and returned."
                    }
                  ]
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"timestamp\": \"1948-09-12T09:44:27.111Z\",\n  \"aggregations\": {},\n  \"links\": [\n    {\n      \"type\": \"string\",\n      \"rel\": \"string\",\n      \"title\": \"string\",\n      \"href\": \"string\"\n    },\n    {\n      \"type\": \"string\",\n      \"rel\": \"string\",\n      \"title\": \"string\",\n      \"href\": \"string\"\n    }\n  ]\n}",
              "cookie": [],
